# Database
DATABASE_URL=postgresql://ledgerpilot:ledgerpilot_dev@localhost:5432/ledgerpilot_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-long-secret

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Object Storage (S3-compatible)
STORAGE_PROVIDER=local          # local | s3 | r2
STORAGE_BUCKET=ledgerpilot-docs
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=               # for Cloudflare R2 or DigitalOcean Spaces

# Email (transactional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ledgerpilot.co.ke

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=sandbox

# Feature flags
ENABLE_OCR=false
ENABLE_AI=false
ENABLE_WHATSAPP=false
